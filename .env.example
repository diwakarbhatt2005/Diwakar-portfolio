# Copy to .env.local and fill in.

# Where contact-form messages are delivered (also shown on the site).
NEXT_PUBLIC_CONTACT_EMAIL=diwakarbhatt1983@gmail.com

# Resend API key — https://resend.com/api-keys
# Without it, local dev just logs submissions to the terminal instead of emailing.
RESEND_API_KEY=

# Sender address. "onboarding@resend.dev" only delivers to your own Resend account
# email; verify your domain in Resend to send from e.g. "Portfolio <hello@yourdomain.com>".
RESEND_FROM=Portfolio <onboarding@resend.dev>

# Your live URL, used for social-share (OpenGraph) image links.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Footer social links (leave empty to hide).
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_GITHUB_URL=
